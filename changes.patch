+// MARK: - AI edit (the overlay: MediaEditorAIEdit.swift; the edit: MediaEditorAIEditService.swift)
+
+extension MediaEditorScreenImpl.Node {
+    /// The Agent's button is in the top row for a photo in the story editor.
+    var isAIEditAvailable: Bool {
+        guard let controller = self.controller, case .storyEditor = controller.mode, controller.collage == nil, let subject = self.subject, let mediaEditor = self.mediaEditor, !mediaEditor.sourceIsVideo else {
+            return false
+        }
+        switch subject {
+        case .image, .asset, .draft:
+            return subject.isPhoto
+        default:
+            return false
+        }
+    }
+    
+    /// Circle a place on the photo and say what to put there; only that place changes.
+    func presentAIEdit() {
+        guard self.aiEditView == nil, self.isAIEditAvailable, let mediaEditor = self.mediaEditor, let mediaEntityView = self.entitiesView.getView(where: { $0 is DrawingMediaEntityView }) else {
+            return
+        }
+        self.controller?.dismissAllTooltips()
+        self.entitiesView.selectEntity(nil)
+        
+        // The editor's controls step aside while the overlay is up: the top row and the caption, and the bottom row.
+        let controlsViews: [UIView?] = [self.componentHost.view, self.bottomControlsContainerView]
+        let aiEditView = MediaEditorAIEditView(
+            strings: self.presentationData.strings,
+            mediaEditor: mediaEditor,
+            previewView: self.previewContainerView,
+            mediaEntityView: mediaEntityView,
+            controlsViews: controlsViews.compactMap { $0 },
+            // Telegram's Agent takes this place once its API is open (see MediaEditorAIEditStubService).
+            service: MediaEditorAIEditStubService()
+        )
+        aiEditView.apply = { [weak self] image, displayed in
+            self?.applyAIEditedImage(image, displayed: displayed)
+        }
+        aiEditView.failed = { [weak self] in
+            self?.presentAIEditError()
+        }
+        aiEditView.dismissed = { [weak self, weak aiEditView] in
+            guard let self, self.aiEditView === aiEditView else {
+                return
+            }
+            self.aiEditView = nil
+            self.requestLayout(forceUpdate: false, transition: .immediate)
+        }
+        self.containerView.addSubview(aiEditView)
+        self.aiEditView = aiEditView
+        self.requestLayout(forceUpdate: false, transition: .immediate)
+        aiEditView.animateIn()
+    }
+    
+    fileprivate func updateAIEditLayout(layout: ContainerViewLayout, previewFrame: CGRect, transition: ComponentTransition) {
+        guard let aiEditView = self.aiEditView else {
+            return
+        }
+        // The row of the editor's own bottom controls (updateBottomControls).
+        let controlsLayout = self.controlsLayout(layout)
+        let hasReservedCorners = controlsLayout.reservedCorners != .none
+        let geometry = mediaEditorStoryBottomControlsGeometry(
+            size: controlsLayout.size,
+            isTablet: controlsLayout.metrics.isTablet,
+            statusBarHeight: controlsLayout.navigationBarStatusBarHeight ?? 0.0,
+            safeBottomInset: self.lastBottomInset,
+            hasStatusIsland: controlsLayout.navigationBarTrailingButtonsInset > 0.0,
+            hasReservedCorners: hasReservedCorners,
+            bottomEdgeRightInset: bottomEdgeSideInsets(safeInsets: controlsLayout.safeInsets, reservedCorners: controlsLayout.reservedCorners).right,
+            cameraRowHomeIndicatorInset: mediaEditorStoryBottomControlsAlignWithCameraRow(deviceMetrics: controlsLayout.deviceMetrics, isTablet: controlsLayout.metrics.isTablet, hasReservedCorners: hasReservedCorners) ? controlsLayout.intrinsicInsets.bottom : nil
+        )
+        aiEditView.update(
+            layout: MediaEditorAIEditView.Layout(
+                size: layout.size,
+                previewFrame: previewFrame,
+                rowFrame: geometry.panelFrame.offsetBy(dx: self.controlsBandOriginX, dy: 0.0),
+                sideInset: geometry.spec.sideInset,
+                inputHeight: layout.inputHeight ?? 0.0
+            ),
+            transition: transition
+        )
+    }
+    
+    /// The edited photo becomes the editor's photo: the renderer draws it from now on with the same crop, tools and
+    /// entities, and the subject (with its item, when several are edited) holds it, so a draft, the export of a story
+    /// that becomes a video and a return to this item keep the edit.
+    private func applyAIEditedImage(_ image: UIImage, displayed: @escaping () -> Void) {
+        guard let mediaEditor = self.mediaEditor, let subject = self.subject else {
+            displayed()
+            return
+        }
+        let dimensions = PixelDimensions(width: Int32(image.size.width * image.scale), height: Int32(image.size.height * image.scale))
+        switch subject {
+        case .image, .asset:
+            if let index = self.items.firstIndex(where: { $0.source.identifier == subject.sourceIdentifier }) {
+                self.items[index].source = .image(image, dimensions)
+            }
+        default:
+            break
+        }
+        if case let .image(_, _, additionalImage, additionalImagePosition, fromCamera) = subject {
+            self.subject = .image(image: image, dimensions: dimensions, additionalImage: additionalImage, additionalImagePosition: additionalImagePosition, fromCamera: fromCamera)
+        } else {
+            self.subject = .image(image: image, dimensions: dimensions, additionalImage: nil, additionalImagePosition: .bottomLeft, fromCamera: false)
+        }
+        
+        mediaEditor.setOnNextDisplay(displayed)
+        mediaEditor.replaceMainImage(image)
+        
+        self.hasAnyChanges = true
+        self.controller?.isSavingAvailable = true
+        self.controller?.requestLayout(transition: .animated(duration: 0.25, curve: .easeInOut))
+    }
+    
+    private func presentAIEditError() {
+        guard let controller = self.controller else {
+            return
+        }
+        let presentationData = self.context.sharedContext.currentPresentationData.with { $0 }
+        controller.present(UndoOverlayController(presentationData: presentationData, content: .info(title: nil, text: presentationData.strings.Login_UnknownError, timeout: nil, customUndoText: nil), elevatedLayout: false, position: .top, animateInAsReplacement: false, action: { _ in
+            return false
+        }), in: .current)
+    }
+}
